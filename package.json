{
  "name": "mahamerujs",
  "private": true,
  "scripts": {
    "prepare": "turbo run build --filter=@mahameru/cli... --filter=create-mahameru... --filter=@mahameru/diatrema... --filter=@mahameru/magma... --filter=mahameru...",
    "dev": "turbo watch dev --filter=blank-test...",
    "dev:blank": "turbo watch dev --filter=blank-test...",
    "dev:http": "turbo watch dev --filter=http-test...",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=@mahameru/cli...",
    "build:create-mahameru": "turbo run build --filter=create-mahameru...",
    "build:diatrema": "turbo run build --filter=@mahameru/diatrema...",
    "build:magma": "turbo run build --filter=@mahameru/magma...",
    "build:mahameru": "turbo run build --filter=mahameru...",
    "build:plugin": "turbo run build --filter=@mahameru/plugin...",
    "clean": "rimraf --glob .turbo \"packages/*/dist\" \"packages/*/.turbo\" \"packages/*/.tsbuildinfo.json\" \"packages/*/dist.tgz\" \"tests/*/.turbo\" \"tests/*/.mahameru\" \"tests/*/.types\" \"tests/*/mahameru.d.ts\" node_modules/.cache",
    "clean:all": "pnpm clean && rimraf --glob \"packages/*/node_modules\" \"tests/*/node_modules\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "typecheck": "turbo run typecheck",
    "change": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.15.1"
}
